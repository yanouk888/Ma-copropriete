# Configuration du projet Firebase (console Firebase → Paramètres du projet →
# Vos applications → Configuration du SDK). À renseigner dans Vercel
# (Settings → Environment Variables) et, pour le développement, dans .env.local.
#
# Ces valeurs ne sont pas des secrets : elles partent dans le bundle. Ce sont
# les règles Firestore qui protègent les données. Elles vivent pourtant ici
# plutôt que dans le code, pour qu'on puisse changer de projet Firebase ou de
# nom de domaine sans toucher au dépôt.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Clé publique des notifications poussées (console Firebase → Paramètres du
# projet → Cloud Messaging → Certificats Web Push → Générer une paire de clés).
VITE_FIREBASE_VAPID_KEY=

# Développement seulement : mettre 1 pour parler aux émulateurs locaux
# (firebase emulators:start) au lieu du vrai projet.
VITE_EMULATEURS=
